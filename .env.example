# Local development defaults. These match docker-compose.yml and are NOT secrets.
# Never put real credentials in this file; production values come from the host's secret store.
DATABASE_URL=postgres://pharma:local-dev-only@localhost:5432/pharma
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-dev-only
S3_SECRET_ACCESS_KEY=local-dev-only-secret
S3_PRIVATE_BUCKET=pharma-private
S3_PUBLIC_BUCKET=pharma-public
SMTP_HOST=localhost
SMTP_PORT=1025
LOG_LEVEL=debug
APP_URL=http://localhost:3000
# Better Auth signing/encryption secret (min 32 chars). Local-only value; production
# gets its own from the secret store (generate with `openssl rand -base64 32`).
BETTER_AUTH_SECRET=local-dev-only-not-a-secret-change-me-0000
EMAIL_FROM='"منصة الصيادلة (محلي)" <no-reply@pharmacist-platform.local>'
# Have I Been Pwned range check. Defaults to true when unset (production); off locally
# and in tests so they need no network access.
AUTH_BREACHED_PASSWORD_CHECK=false
# clamd malware scanner, used by the worker only (`pnpm worker`). Local compose service.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
