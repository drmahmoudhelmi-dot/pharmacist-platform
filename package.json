{
  "name": "pharmacist-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/shared/db/migrate.ts",
    "admin:grant-role": "tsx --env-file-if-exists=.env src/modules/identity/cli/role-admin.ts grant",
    "admin:revoke-role": "tsx --env-file-if-exists=.env src/modules/identity/cli/role-admin.ts revoke",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "bootstrap": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
