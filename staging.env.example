# Staging rehearsal configuration. Copy to staging.env (git-ignored) and edit:
#   cp staging.env.example staging.env
#   docker compose -f docker-compose.staging.yml --env-file staging.env up -d --build --wait
# Every value here is a PLACEHOLDER. Never commit real credentials. On a real
# host these come from the host's secret store, not from a file in the repo.
# The same file feeds Compose (variable interpolation) and the containers.

# ---- Rehearsal-only: host ports (the compose file publishes nothing else) ----
WEB_PORT=3000
MAILPIT_UI_PORT=8025
# MinIO API on the host. Presigned URLs use S3_ENDPOINT, so the browser must be
# able to open it: map `127.0.0.1 minio` in your hosts file and keep this 9000
# (S3_ENDPOINT below uses port 9000). Change it only to avoid a port clash.
MINIO_API_PORT=9000

# ---- Database (web, worker, migrate) ----
# POSTGRES_* configure the rehearsal Postgres container and must match DATABASE_URL.
# On a real host, DATABASE_URL points at the managed database and POSTGRES_* go away.
POSTGRES_USER=pharma
POSTGRES_PASSWORD=change-me-staging-db-password
POSTGRES_DB=pharma
DATABASE_URL=postgres://pharma:change-me-staging-db-password@postgres:5432/pharma

# ---- Object storage (web, worker) ----
# Rehearsal: the MinIO container. MINIO root user/password are taken from the
# S3_* access pair below. Any S3-compatible endpoint works; the private bucket
# must exist, be private and have versioning on; quarantine/ needs a 1-day lifecycle rule.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=staging-access-key-placeholder
S3_SECRET_ACCESS_KEY=staging-secret-key-placeholder-change-me
S3_PRIVATE_BUCKET=pharma-private
S3_PUBLIC_BUCKET=pharma-public

# ---- Email (web, worker) ----
# Rehearsal: Mailpit catches everything (UI on MAILPIT_UI_PORT). Point at a
# sandbox provider's SMTP relay on a real host.
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM='"منصة الصيادلة (staging)" <no-reply@staging.invalid>'

# ---- App (web, worker) ----
# Public origin. Better Auth trusts only this origin and email links use it.
# Placeholder national ID keys below are accepted only while this is localhost.
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Signs sessions and tokens, encrypts TOTP secrets. At least 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=staging-placeholder-replace-with-openssl-rand-base64-32
# Have I Been Pwned range check on sign-up. "false" only for offline rehearsal;
# leave it "true" (the default) on a host with internet access.
AUTH_BREACHED_PASSWORD_CHECK=false

# ---- National ID protection (web only; read when a national ID is handled) ----
# 32 bytes each, base64, and different from each other. Repeated-byte
# placeholders: refused unless APP_URL is localhost. Real values:
#   openssl rand -base64 32
# Back the encryption key up separately from the database (losing it loses every
# stored national ID). Never change the hash key without re-hashing every row.
NATIONAL_ID_ENCRYPTION_KEY=ERERERERERERERERERERERERERERERERERERERERERE=
NATIONAL_ID_HASH_KEY=IiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiIiI=
# Optional during rotation: old encryption keys, comma-separated, decrypt-only.
# NATIONAL_ID_ENCRYPTION_PREVIOUS_KEYS=

# ---- Malware scanner (worker only) ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Rehearsal: "true" skips signature updates so start-up needs no network.
# A real host runs freshclam: set "false".
CLAMAV_NO_FRESHCLAMD=true
